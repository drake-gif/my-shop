/*
  Paste into Firebase Console > Storage > Rules > Publish.
  Everyone can VIEW product photos (so they show on the shop page); only a signed-in
  admin can UPLOAD/DELETE them.
*/
rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    match /products/{fileName} {
      allow read: if true;
      allow write: if request.auth != null;
    }
  }
}
